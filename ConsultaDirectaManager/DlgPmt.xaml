<Window
    x:Class="ConsultaDirectaManager.DlgPmt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConsultaDirectaManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Parámetros"
    Width="320"
    Height="320"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid
            x:Name="gridPmts"
            AlternatingRowBackground="LightGray"
            AutoGenerateColumns="False"
            CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding PmtName}"
                    Header="Nombre"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding PmtDsc}"
                    Header="Descripción"
                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding PmtVlr}" Header="Valor" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="1"
            Margin="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnOk"
                MinWidth="100"
                Margin="2"
                Click="btnOk_Click"
                Content="Ok" />
            <Button
                x:Name="btnCnc"
                MinWidth="100 "
                Margin="2"
                Click="btnCnc_Click"
                Content="Cancelar" />
        </StackPanel>
    </Grid>
</Window>
