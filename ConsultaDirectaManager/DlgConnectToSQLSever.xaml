<Window
    x:Class="ConsultaDirectaManager.ConnectSQLSever"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ConsultaDirectaManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConsultaDirectaManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Conectar a SQL Sever"
    Width="400"
    Height="280"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>

        <Style x:Key="checkEnabled" TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=chkEsWindowsAutentication, Path=IsChecked}" Value="True">
                    <Setter Property="TextBox.IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=chkEsWindowsAutentication, Path=IsChecked}" Value="False">
                    <Setter Property="TextBox.IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </Window.Resources>

    <Grid Margin="5" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Label>Servidor</Label>
        <TextBox
            x:Name="txtServidor"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Height="25"
            Text="(local)"
            TextChanged="txtServidor_TextChanged"
            TextWrapping="Wrap" />
        <CheckBox
            x:Name="chkEsWindowsAutentication"
            Grid.Row="1"
            Grid.Column="1"
            Padding="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Checked="chkEsWindowsAutentication_Checked"
            Content="Autenticación de Windows"
            Unchecked="chkEsWindowsAutentication_Unchecked" />
        <Border
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Width="250"
            Margin="4"
            Padding="2"
            HorizontalAlignment="Left"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label IsEnabled="{Binding IsChecked, ElementName=chkEsWindowsAutentication, Converter={StaticResource InverseBooleanConverter}}">Usuario</Label>
                <TextBox
                    x:Name="txtUsr"
                    Grid.Row="0"
                    Grid.Column="1"
                    IsEnabled="{Binding IsChecked, ElementName=chkEsWindowsAutentication, Converter={StaticResource InverseBooleanConverter}}" />
                <Label Grid.Row="1" IsEnabled="{Binding IsChecked, ElementName=chkEsWindowsAutentication, Converter={StaticResource InverseBooleanConverter}}">Contraseña</Label>
                <PasswordBox
                    x:Name="txtPsw"
                    Grid.Row="1"
                    Grid.Column="1"
                    IsEnabled="{Binding IsChecked, ElementName=chkEsWindowsAutentication, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource PasswordBoxStyle}" />
            </Grid>
        </Border>
        <Label Grid.Row="4">Base de Datos</Label>
        <TextBox
            x:Name="txtBasedeDatos"
            Grid.Row="4"
            Grid.Column="1"
            Height="25" />

        <StackPanel
            Grid.Row="6"
            Grid.Column="1"
            Margin="0,5,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="cmdTest"
                Click="cmdTest_Click"
                Style="{StaticResource ButtonStyle}">
                _Probar
            </Button>
            <Button
                x:Name="cmdOk"
                Click="cmdOk_Click"
                IsDefault="True"
                Style="{StaticResource ButtonStyle}">
                _Aceptar
            </Button>
            <Button
                x:Name="cmdCancel"
                Click="cmdCancel_Click"
                IsCancel="True"
                Style="{StaticResource ButtonStyle}">
                _Cancelar
            </Button>
        </StackPanel>
    </Grid>
</Window>
